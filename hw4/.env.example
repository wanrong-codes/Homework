# 至少配置两家 provider 才能体现“多 provider 路由”；没有 Key 可设 MOCK_LLM=1 离线跑通
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# cheap / strong 两档模型分别落到哪个 provider（默认如下）
CHEAP_PROVIDER=deepseek
CHEAP_MODEL=deepseek-chat
STRONG_PROVIDER=openai
STRONG_MODEL=gpt-4o

# RAG embedding：hash（本地，默认） | api（调用 provider 的 /embeddings）
EMBED_MODE=hash
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

MCP_SERVER_URL=http://127.0.0.1:9000
# MOCK_LLM=1
